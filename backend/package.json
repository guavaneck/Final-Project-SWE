{
  "name": "social-app-backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test:db": "tsx --env-file-if-exists=../.env --test tests/db.integration.ts",
    "test:auth": "tsx --test tests/auth.unit.ts",
    "test:posts": "tsx --test tests/posts.unit.ts",
    "test:media": "tsx --test tests/media.unit.ts",
    "dev": "tsx watch --env-file-if-exists=../.env src/main.ts",
    "start": "node --env-file-if-exists=../.env dist/main.js",
    "db:seed-demo": "tsx --env-file-if-exists=../.env scripts/seed-demo.ts",
    "media:cleanup": "tsx --env-file-if-exists=../.env scripts/clean-up-media.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "prisma": "7.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "@ffprobe-installer/linux-x64@5.2.0": true
  }
}
