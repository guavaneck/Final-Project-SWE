POSTGRES_DB=social_app
POSTGRES_USER=social_app
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433
DATABASE_URL=postgresql://social_app:change-me@localhost:5433/social_app
S3_ACCESS_KEY=local-access-key
S3_SECRET_KEY=change-me-too
S3_BUCKET=media
S3_PORT=8333
# Optional. Where the API reaches storage, and the address browsers use for upload/view URLs.
# Both default to http://localhost:$S3_PORT.
# S3_ENDPOINT=http://localhost:8333
# S3_PUBLIC_ENDPOINT=http://localhost:8333
# Optional. Path to ffprobe; defaults to the binary from @ffprobe-installer/ffprobe.
# FFPROBE_PATH=/usr/bin/ffprobe
# Optional. Minutes between abandoned-upload cleanups in the API server; 0 turns them off. Defaults to 15.
# MEDIA_CLEANUP_INTERVAL_MINUTES=15
